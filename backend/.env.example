# Copie para .env e ajuste. Tudo tem default seguro para desenvolvimento.

# Banco. SQLite (default) não precisa de nada instalado:
DATABASE_URL=sqlite:///./motiva.db
# Postgres (via docker compose):
# DATABASE_URL=postgresql+psycopg://motiva:motiva@localhost:5432/motiva

# Provedores de voz/NLU (opcionais no MVP inicial — sem chave, usa o stub local):
# OPENAI_API_KEY=
NLU_PROVIDER=rule_based        # rule_based | openai
